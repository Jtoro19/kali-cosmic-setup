# Source: pop-os/cosmic-greeter, tag epoch-1.11.0 (cosmic-greeter.service).
# Changes: ExecStart uses the absolute path /usr/sbin/greetd (Debian's greetd
# binary); the [Install] section is active with Alias=display-manager.service
# (upstream leaves it commented out, "Managed by debconf").
[Unit]
Description=COSMIC Greeter
After=systemd-user-sessions.service plymouth-quit-wait.service cosmic-greeter-daemon.service
After=getty@tty1.service kmsconvt@tty1.service
Conflicts=getty@tty1.service kmsconvt@tty1.service
Wants=cosmic-greeter-daemon.service

[Service]
Type=simple
ExecStart=/usr/sbin/greetd --config /etc/greetd/cosmic-greeter.toml
IgnoreSIGPIPE=no
SendSIGHUP=yes
TimeoutStopSec=30s
KeyringMode=shared
Restart=always
RestartSec=1
StartLimitBurst=5
StartLimitInterval=30

[Install]
Alias=display-manager.service
